
%% Circular trajectory input for dead reckoning
x = [0; 0; -pi/2];
v = 10;
r = 1;
w = -v/r;
dt = abs((pi/4)/w);
u = [v; w];                % your commanded v,w

X = x;
U_dead = []; 
X_dead = x;
for i = 1:8
    x = GTdeadReckoningMotionModel(x, u, dt);
    
    U_dead = [U_dead, u];
    X_dead = [X_dead, x];
end

%% Circular trajectory input for odometry
x = [0; 0; -pi/2];
% delta 

X_odom = x;
U_odom = [];
for i = 1:8

    u = [X_dead(:,i);  X_dead(:,i+1)];
    x = GTodometryMotionModel(x, u);

    U_odom = [U_odom, u];
    X_odom = [X_odom, x];

end


%% Circular trajectory for dead reckoning model
x = [0; 0; -pi/2];
size_U = length(U_dead(1,:));

alpha = [0.1 0.1 0.1 0.1 0.01 0.01]';   % tune these
sample_size = 1000;
% X_dead_sample = concta mxNxtime;
X_dead_sample = repmat(x,1,sample_size,size_U);

for i=1:size_U
    x = sampleDeadReckoningMotionModel(x, U_dead(:,i), alpha, dt);

    X_dead_hat = [X_dead_hat, x];
end



