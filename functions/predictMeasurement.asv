function [z_pred, H, validLandmarks] = predictMeasurement(x_pred, landmarks, sensorParams)
%PREDICTMEASUREMENT Predict range-bearing measurements to landmarks (for EKF with sensor limits)
%
%   [z_pred, H, validLandmarks] = predictMeasurement(x_pred, landmarks, sensorParams)
%
%   Inputs:
%       x_pred       : [3×1] predicted robot pose [x; y; theta]
%       landmarks    : [N×3] matrix of all landmarks [id, x, y]
%       sensorParams : struct with fields:
%                      .maxRange - maximum sensor range (m)
%                      .fov      - field of view (radians)
%
%   Outputs:
%       z_pred         : [2K×1] predicted measurements for VISIBLE landmarks only
%                        [range1; bearing1; range2; bearing2; ...]
%       H              : [2K×3] measurement Jacobian matrix (for EKF update)
%       validLandmarks : [K×3] subset of landmarks within sensor limits
%                        Used for data association with actual measurements
%
%   Data Association:
%       Only landmarks within sensor limits are included in predictions.
%       This ensures synchronization between predicted and actual measurements.
%       Use validLandmarks to match with detectLandmarksFromScan output.
%
%   Note: This function is deterministic (no noise).

    % Extract robot pose
    x = x_pred(1);
    y = x_pred(2);
    theta = x_pred(3);
    
    % Extract sensor parameters
    maxRange = sensorParams.maxRange;
    fov = sensorParams.fov;
    maxBearing = fov / 2;  % Half FOV in radians
    
    % Number of landmarks
    N = size(landmarks, 1);
    
    % Check visibility for each landmark
    validIdx = false(N, 1);
    tempRanges = zeros(N, 1);
    tempBearings = zeros(N, 1);
    
    for i = 1:N
        % Landmark position
        lx = landmarks(i, 2);
        ly = landmarks(i, 3);
        
        % Relative position
        delta_x = lx - x;
        delta_y = ly - y;
        
        % Range and bearing
        range = sqrt(delta_x^2 + delta_y^2);
        bearing = atan2(delta_y, delta_x) - theta;
        bearing = wrapToPi(bearing);
        
        % Check sensor limits
        if range <= maxRange && abs(bearing) <= maxBearing
            validIdx(i) = true;
            tempRanges(i) = range;
            tempBearings(i) = bearing;
        end
    end
    
    % Extract valid landmarks
    validLandmarks = landmarks(validIdx, :);
    K = size(validLandmarks, 1);
    
    % Initialize outputs
    z_pred = zeros(2*K, 1);
    H = zeros(2*K, 3);
    
    % Process each valid landmark
    for i = 1:K
        % Landmark position
        lx = validLandmarks(i, 2);
        ly = validLandmarks(i, 3);
        
        % Relative position
        delta_x = lx - x;
        delta_y = ly - y;
        
        % Distance squared
        q = delta_x^2 + delta_y^2;
        
        % Predicted measurements
        range = sqrt(q);
        bearing = atan2(delta_y, delta_x) - theta;
        bearing = wrapToPi(bearing);  % Normalize to [-pi, pi]
        
        % Store in measurement vector
        z_pred(2*i-1) = range;
        z_pred(2*i)   = bearing;
        
        % Measurement Jacobian for this landmark
        % H_i = [∂range/∂x,  ∂range/∂y,  ∂range/∂θ;
        %        ∂bearing/∂x, ∂bearing/∂y, ∂bearing/∂θ]
        
        sqrt_q = sqrt(q);
        
        % Range derivatives
        H(2*i-1, 1) = -delta_x / sqrt_q;   % ∂range/∂x
        H(2*i-1, 2) = -delta_y / sqrt_q;   % ∂range/∂y
        H(2*i-1, 3) = 0;                   % ∂range/∂θ
        
        % Bearing derivatives
        H(2*i, 1) = delta_y / q;           % ∂bearing/∂x
        H(2*i, 2) = -delta_x / q;          % ∂bearing/∂y
        H(2*i, 3) = -1;                    % ∂bearing/∂θ
    end
    
    % Handle case with no valid landmarks
    if K == 0
        z_pred = [];
        H = [];
        validLandmarks = zeros(0, 3);  % Empty 0×3 array (preserve dimensions)
    end
end

%% Sample usage:
% x_pred = [2; 3; pi/4];              % Predicted robot pose
% landmarks = [1, 5, 7;               % All landmarks
%              2, 8, 4;
%              3, 15, 2];             % This one might be out of range
% sensorParams.maxRange = 10;         % 10m max range
% sensorParams.fov = 90;              % 90° field of view
% 
% [z_pred, H, validLandmarks] = predictMeasurement(x_pred, landmarks, sensorParams);
% 
% % z_pred contains predictions only for landmarks within sensor limits
% % validLandmarks contains the subset of landmarks that are visible
% % Use validLandmarks for data association with actual detections
